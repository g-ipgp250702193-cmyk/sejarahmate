# SejarahMate AI — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Server ─────────────────────────────────────────────────────
PORT=3000

# ── Telegram Bot (Optional — fill in after @BotFather setup) ──
# Leave as placeholder until you have your token.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ── Deployment URL (required for Telegram webhook) ─────────────
# Your public HTTPS URL (e.g. from Render, Railway, or ngrok)
PUBLIC_URL=https://your-app.onrender.com
